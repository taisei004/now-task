{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "now-task",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-18",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/discord/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "now-task",
      "database_id": "f706504d-8085-4441-8d79-d15c6791be8b",
      "migrations_dir": "migrations",
    },
  ],
  "ai": { "binding": "AI", "remote": true },
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "DISCORD_APPLICATION_ID": "1561466054452969512",
    "DISCORD_PUBLIC_KEY": "e740e90d2249e3183f1c812f39ba00e895ce0d91bd4633ba1497d57b00521d72",
    "DISCORD_GUILD_ID": "1433011113599045704",
    "DISCORD_CHANNEL_ID": "1480597044425916469",
  },
  "observability": { "enabled": true },
}
